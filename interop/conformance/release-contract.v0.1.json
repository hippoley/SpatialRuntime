{
  "schema": "spatialruntime.conformance-release-contract.v0.1",
  "tag_pattern": "^conformance-v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "versioning": {
    "patch": "compatible correctness fix or hardening",
    "minor": "additive public capability with existing modes preserved",
    "major": "intentional breaking public contract change"
  },
  "required_checks": [
    "interop/conformance/verify_catalog.py",
    "interop/external-results/verify_registry.py",
    "repository CI green on supported Python versions"
  ],
  "required_release_manifest_fields": [
    "schema",
    "tag",
    "commit",
    "catalog_schema",
    "included_modes",
    "compatibility_aliases",
    "changelog"
  ],
  "deprecation": {
    "minimum_minor_release_window": 1,
    "silent_removal_forbidden": true,
    "removal_requires_major_release": true,
    "correctness_exception_requires_changelog": true
  },
  "pinning": {
    "before_first_tag": "immutable Git commit SHA",
    "after_release": "immutable conformance-v* tag preferred",
    "main_allowed_for_historical_evidence": false
  }
}
