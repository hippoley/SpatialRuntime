{
  "schema": "spatialruntime.interop.conformance.catalog.v0.1",
  "status": "experimental",
  "preferred_action": "interop/conformance",
  "legacy_compatible_actions": [
    "interop/agent-effect-authority"
  ],
  "result_semantics": {
    "PASS": "Supplied evidence satisfies the selected profile.",
    "UNRESOLVED": "Evidence is insufficient to reach a safe pass/fail conclusion.",
    "FAIL": "Supplied evidence contradicts or violates the selected profile."
  },
  "profiles": [
    {
      "mode": "claim",
      "profile": "agent-effect-authority.v0.1",
      "entrypoint": "interop/agent-effect-authority/verify_claim.py",
      "structured_action_result": true,
      "profile_source": "interop/agent-effect-authority/manifest.json",
      "profile_key": "spec",
      "requires_file": true,
      "outputs": [
        "conformance_result"
      ]
    },
    {
      "mode": "mapping",
      "profile": "effect-authority.semantic-mapping.v0.1",
      "entrypoint": "interop/agent-effect-authority/verify_semantic_mapping.py",
      "structured_action_result": true,
      "profile_source": "interop/agent-effect-authority/mappings/narada.v0.1.json",
      "profile_key": "mapping_spec",
      "requires_file": true,
      "outputs": [
        "conformance_result"
      ]
    },
    {
      "mode": "mapping-v0.2",
      "profile": "effect-authority.semantic-mapping.v0.2",
      "entrypoint": "interop/agent-effect-authority/verify_semantic_mapping_v02.py",
      "structured_action_result": true,
      "profile_source": "interop/agent-effect-authority/mappings/narada.v0.2.json",
      "profile_key": "mapping_spec",
      "requires_file": true,
      "outputs": [
        "conformance_result"
      ]
    },
    {
      "mode": "tool-decision-lifecycle",
      "profile": "otel-tool-decision-lifecycle.v0.1",
      "entrypoint": "interop/otel-tool-decision-lifecycle/verify.py",
      "structured_action_result": true,
      "outputs": [
        "conformance_result",
        "lifecycle_result",
        "unresolved_count",
        "error_count"
      ],
      "profile_source": "interop/otel-tool-decision-lifecycle/profile.v0.1.json",
      "profile_key": "profile",
      "requires_file": true
    },
    {
      "mode": "decision-execution-binding",
      "profile": "decision-execution-binding.v0.1",
      "entrypoint": "interop/decision-execution-binding/verify.py",
      "structured_action_result": true,
      "outputs": [
        "conformance_result",
        "unresolved_count",
        "error_count"
      ],
      "profile_source": "interop/decision-execution-binding/profile.v0.1.json",
      "profile_key": "profile",
      "requires_file": true
    },
    {
      "mode": "decision-execution-binding-v0.2",
      "profile": "decision-execution-binding.v0.2",
      "entrypoint": "interop/decision-execution-binding/verify_v0_2.py",
      "structured_action_result": true,
      "outputs": [
        "conformance_result",
        "unresolved_count",
        "error_count"
      ],
      "profile_source": "interop/decision-execution-binding/profile.v0.2.json",
      "profile_key": "profile",
      "requires_file": true,
      "additive_to": "decision-execution-binding"
    },
    {
      "mode": "effect-evidence-bundle",
      "profile": "effect-evidence-v0.1",
      "entrypoint": "interop/agent-effect-authority/run_conformance.py",
      "profile_source": "interop/agent-effect-authority/conformance-bundle.v0.1.json",
      "profile_key": "bundle",
      "external_adapter_protocol": "effect-evidence-adapter.v0.1",
      "external_adapter_source": "interop/agent-effect-authority/adapter-protocol.v0.1.json",
      "structured_action_result": true,
      "requires_file": false,
      "accepts_adapter_command": true,
      "outputs": [
        "conformance_result",
        "passed_count",
        "failed_count",
        "total_count",
        "report_path"
      ],
      "supports_durable_report": true
    },
    {
      "mode": "effect-evidence-v0.2",
      "profile": "authoritative-effect-evidence.v0.2",
      "entrypoint": "interop/agent-effect-authority/verify_effect_observation_v02.py",
      "requires_policy": true,
      "structured_action_result": true,
      "profile_source": "interop/agent-effect-authority/evidence-profile.v0.2.json",
      "profile_key": "profile",
      "requires_file": true,
      "outputs": [
        "conformance_result"
      ]
    }
  ]
}
